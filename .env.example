# PostgreSQL
POSTGRES_DB=import_calculator
POSTGRES_USER=import_calculator
POSTGRES_PASSWORD=change-me-before-use
DATABASE_URL=postgres://import_calculator:change-me-before-use@localhost:5432/import_calculator?sslmode=disable

# Backend (если BACKEND_PORT не задан, берётся PORT — его задают хостинги вроде Render)
BACKEND_PORT=8080
SESSION_COOKIE_NAME=import_calculator_session
SESSION_TTL_HOURS=24
# Use true behind HTTPS. Keep false only for local HTTP development.
COOKIE_SECURE=false

# false — закрыть самостоятельную регистрацию (на публичном сервере); сотрудников
# тогда создаёт bootstrap-admin. По умолчанию регистрация открыта.
ALLOW_REGISTRATION=true

# Регистрация создаёт обычных сотрудников без отдельной роли или секрета.
# Сессии хранятся в PostgreSQL; лимит входа/регистрации — 10 попыток в минуту
# на IP/email в одном процессе backend.

# DeepSeek (server-only): оценка соотношения цен для кнопки «Подобрать с ИИ».
# Без ключа цены подбираются только математикой.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Подбор керамики (/ceramics): любой OpenAI-совместимый Chat Completions API.
# Пустые значения — тот же DeepSeek (DEEPSEEK_API_KEY, DEEPSEEK_MODEL, https://api.deepseek.com).
# CERAMICS_AI_VISION=true (по умолчанию) отправляет модели фото товара; deepseek-flash
# изображения принимает. Для модели без изображений поставьте false.
# Рекомендуется та же Gemini 3.8 Flash, что и для фото в агенте (модель, ключ и адрес — см. TNVED_AI_VISION_*).
CERAMICS_AI_API_KEY=
CERAMICS_AI_BASE_URL=
CERAMICS_AI_MODEL=
CERAMICS_AI_VISION=true

# ИИ-агент подбора кода ТН ВЭД (кнопка «ИИ» в строке сметы) и база решений. Пустые значения —
# тот же DeepSeek (DEEPSEEK_API_KEY, модель deepseek-flash: понимает фото и вызывает инструменты).
# TNVED_AI_MODEL — модель рассуждений: цикл агента, итог, самопроверка, чат-справочник, «Документы
# для ввоза». С моделью для фото (ниже) рекомендуется deepseek-v4-pro (фото не принимает).
# TNVED_AI_DAILY_LIMIT — запусков агента на сотрудника в сутки. Цены (USD за 1 млн токенов: ввод,
# ввод из кэша, вывод) — только для учёта расхода; для deepseek-v4-pro в часы пик: 1.32 / 0.044 / 3.96.
# TNVED_AI_NAMING_RULE — правило наименования для декларации (пусто — правило из
# backend/internal/service/tnvedagent/prompt.go).
# TNVED_AI_PROVIDER — anthropic (Claude: смотрит фото сам, ключ по умолчанию ANTHROPIC_API_KEY) или пусто
#   (OpenAI-совместимый адрес TNVED_AI_BASE_URL, ключ по умолчанию DEEPSEEK_API_KEY). С 2026-11-05 рекомендуется
#   Claude Sonnet 5.5: TNVED_AI_PROVIDER=anthropic, TNVED_AI_MODEL=claude-sonnet-5-5, TNVED_AI_EFFORT=high,
#   цены 2 / 0.20 / 10. С Claude задайте TNVED_AI_VISION_API_KEY и TNVED_AI_VISION_BASE_URL явно.
TNVED_AI_PROVIDER=
TNVED_AI_API_KEY=
TNVED_AI_BASE_URL=
TNVED_AI_MODEL=
TNVED_AI_VISION=true
TNVED_AI_DAILY_LIMIT=100
TNVED_AI_PRICE_INPUT=0.30
TNVED_AI_PRICE_CACHED=0.006
TNVED_AI_PRICE_OUTPUT=1.20
TNVED_AI_NAMING_RULE=
# TNVED_AI_VISION_MODEL — модель для фото: описание фото, вопросы агента по фото, похожие товары в базе
# решений, перевод наименования на китайский. Задана — модель TNVED_AI_MODEL фото не получает, только
# их описание текстом. Пусто — всё на одной модели TNVED_AI_MODEL, как раньше.
# Рекомендуется Gemini 3.8 Flash (замер 2026-10-22: читает надписи, DeepSeek Flash их выдумывает):
#   TNVED_AI_VISION_MODEL=gemini-3.8-flash, ключ с aistudio.google.com (платный: бесплатный ключ даёт
#   20 запросов в день и использует фото для обучения), адрес
#   https://generativelanguage.googleapis.com/v1beta/openai, цены 0.75 / 0.075 / 3.75 (с 2027-01-01 вдвое больше).
# Ключ и адрес — пусто: те же, что TNVED_AI_API_KEY и TNVED_AI_BASE_URL. Цены — как у TNVED_AI_PRICE_*.
TNVED_AI_VISION_MODEL=
TNVED_AI_VISION_API_KEY=
TNVED_AI_VISION_BASE_URL=
TNVED_AI_VISION_PRICE_INPUT=0.30
TNVED_AI_VISION_PRICE_CACHED=0.006
TNVED_AI_VISION_PRICE_OUTPUT=1.20
# Теневой подбор: вторая модель подбирает код параллельно с основной (строка сметы или чат-справочник) и
# получает те же сообщения сотрудника; сотрудник её не видит, итоги сравнивает администратор в «Журнале
# агента». Пусто — тени нет.
# TNVED_AI_SHADOW_PROVIDER — anthropic (Claude, ключ по умолчанию ANTHROPIC_API_KEY) или deepseek
#   (OpenAI-совместимый адрес TNVED_AI_SHADOW_BASE_URL, пусто — DeepSeek; ключ по умолчанию DEEPSEEK_API_KEY).
#   При основной Claude тень — deepseek-v4-pro с TNVED_AI_SHADOW_EFFORT=low, цены 1.32 / 0.044 / 3.96.
# TNVED_AI_SHADOW_VISION — модель смотрит фото сама (true) или получает описание от модели для фото;
#   пусто — true только у Claude.
# TNVED_AI_SHADOW_BUDGET_USD — потолок расхода тени за всё время (0 — тень выключена);
#   TNVED_AI_SHADOW_DAILY_LIMIT — прогонов в сутки. Цены — USD за 1 млн токенов (ввод, из кэша, вывод),
#   по умолчанию Claude Sonnet 5.5: 2 / 0.20 / 10.
TNVED_AI_SHADOW_MODEL=
TNVED_AI_SHADOW_PROVIDER=anthropic
TNVED_AI_SHADOW_API_KEY=
TNVED_AI_SHADOW_BASE_URL=
TNVED_AI_SHADOW_EFFORT=high
TNVED_AI_SHADOW_VISION=
TNVED_AI_SHADOW_BUDGET_USD=0
TNVED_AI_SHADOW_DAILY_LIMIT=50
# TNVED_AI_EMBED_MODEL — модель эмбеддингов на адресе и ключе модели для фото (gemini-embedding-001,
# 0.15 USD за 1 млн токенов): похожие товары и поиск текстом в базе решений — по смыслу описания фото,
# а не только по словам. Нужно расширение pgvector (миграция 000042). Пусто — поиск только по словам.
TNVED_AI_EMBED_MODEL=
# TAVILY_API_KEY — поиск в интернете для агента подбора кода (tavily.com, бесплатно 1 000 запросов в месяц).
# До 8 обращений за запуск (поиск и чтение страниц, которые сервер не прочитал сам). Пусто — без интернета.
TAVILY_API_KEY=
# TNVED_AI_EFFORT — уровень размышлений модели TNVED_AI_MODEL в подборе кода: low, high, max. Задан — режим
# размышлений DeepSeek включён; пусто — выключен. Рекомендуется low: подбор в 2–3 раза быстрее и дешевле.
TNVED_AI_EFFORT=low
# TNVED_AI_DOCUMENTS_EFFORT — уровень размышлений под-агентов «Документов для ввоза» (каждый проверяет один
# акт справки). Пусто — high: точность документов важнее скорости.
TNVED_AI_DOCUMENTS_EFFORT=

# Used only by `go run ./cmd/bootstrap-admin`.
# Do not commit real values.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
