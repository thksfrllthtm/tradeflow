# PostgreSQL
POSTGRES_DB=import_calculator
POSTGRES_USER=import_calculator
POSTGRES_PASSWORD=change-me-before-use
DATABASE_URL=postgres://import_calculator:change-me-before-use@localhost:5432/import_calculator?sslmode=disable

# Backend (если BACKEND_PORT не задан, берётся PORT — его задают хостинги вроде Render)
BACKEND_PORT=8080
SESSION_COOKIE_NAME=import_calculator_session
SESSION_TTL_HOURS=24
# Use true behind HTTPS. Keep false only for local HTTP development.
COOKIE_SECURE=false

# false — закрыть самостоятельную регистрацию (на публичном сервере); сотрудников
# тогда создаёт bootstrap-admin. По умолчанию регистрация открыта.
ALLOW_REGISTRATION=true

# Регистрация создаёт обычных сотрудников без отдельной роли или секрета.
# Сессии хранятся в PostgreSQL; лимит входа/регистрации — 10 попыток в минуту
# на IP/email в одном процессе backend.

# Папка собранного фронтенда: если задана, backend сам отдаёт сайт с того же адреса.
# Локально не нужна — сайт отдаёт Vite; на сервере сайт отдаёт Vercel.
STATIC_DIR=

# DeepSeek (server-only): оценка соотношения цен для кнопки «Подобрать с ИИ».
# Без ключа цены подбираются только математикой.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro

# Used only by `go run ./cmd/bootstrap-admin`.
# Do not commit real values.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
