# PostgreSQL
POSTGRES_DB=import_calculator
POSTGRES_USER=import_calculator
POSTGRES_PASSWORD=change-me-before-use
DATABASE_URL=postgres://import_calculator:change-me-before-use@localhost:5432/import_calculator?sslmode=disable

# Backend (если BACKEND_PORT не задан, берётся PORT — его задают хостинги вроде Render)
BACKEND_PORT=8080
SESSION_COOKIE_NAME=import_calculator_session
SESSION_TTL_HOURS=24
# Use true behind HTTPS. Keep false only for local HTTP development.
COOKIE_SECURE=false

# false — закрыть самостоятельную регистрацию (на публичном сервере); сотрудников
# тогда создаёт bootstrap-admin. По умолчанию регистрация открыта.
ALLOW_REGISTRATION=true

# Регистрация создаёт обычных сотрудников без отдельной роли или секрета.
# Сессии хранятся в PostgreSQL; лимит входа/регистрации — 10 попыток в минуту
# на IP/email в одном процессе backend.

# Непубличное локальное хранилище исходных XLSX и изображений.
# Для Docker Compose используется /app/data/uploads.
FILE_STORAGE_DIR=./data/uploads

# Supabase Storage вместо FILE_STORAGE_DIR (так на Render). Если SUPABASE_URL пуст,
# файлы хранятся локально. Secret key (sb_secret_...) — только на сервере.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=uploads

# Папка собранного фронтенда: если задана, backend сам отдаёт сайт с того же адреса.
# Локально не нужна — сайт отдаёт Vite; на сервере сайт отдаёт Vercel.
STATIC_DIR=

# AI provider (server-only). New installations use Anthropic Claude Haiku.
AI_PROVIDER=anthropic

# Anthropic Messages API (server-only; leave empty until a key is configured)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# DeepSeek (server-only): оценка соотношения цен для кнопки «Распределить (ИИ + математика)».
# Без ключа кнопка работает как математическое распределение.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro

# Optional Gemini provider. Set AI_PROVIDER=gemini to use it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Used only by `go run ./cmd/bootstrap-admin`.
# Do not commit real values.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
